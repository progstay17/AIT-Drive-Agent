# Keep the API bound to loopback. The tunnel connects to this address.
STORAGE_ROOT=C:\AIT-Drive-Storage
AGENT_HOST=127.0.0.1
AGENT_PORT=4001
AGENT_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# none | cloudflare | chisel
# For Caddy Panel SSH reverse tunnel, keep none; run-tunnel.ps1 manages SSH separately.
TUNNEL_PROVIDER=none

# Cloudflare named tunnel
CLOUDFLARED_PATH=
CLOUDFLARED_TUNNEL_TOKEN=

# Optional Chisel reverse tunnel
CHISEL_PATH=
CHISEL_SERVER=
CHISEL_AUTH=
CHISEL_REMOTE_PORT=14001
